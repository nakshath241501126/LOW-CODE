	 			row = 1
	 			column = 1   
				width = medium
			)
			rejection_reason
			(
    			type = textarea
				displayname = "Rejection Reason"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_notes
			(
    			type = textarea
				displayname = "Approval Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Application Submitted","Under Review","Application Rejected","Approved","Pending Additional Information","Adoption Confirmed","Adoption Completed","Adoption Cancelled"}
			}
		}
