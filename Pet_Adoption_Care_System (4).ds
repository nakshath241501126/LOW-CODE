 application "Pet Adoption Care System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form adopter_registration
		{
			displayname = "Adopter Registration"
			success message = "Adopter Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			full_name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = textarea
				displayname = "Address"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			city
			(
    			type = text
				displayname = "City"
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_species
			(
				type = picklist
				displayname = "Preferred Species"
				values = {"Bird","Cat","Rabbit","Dog","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_breed
			(
    			type = text
				displayname = "Preferred Breed"
	 			row = 1
	 			column = 1   
				width = medium
			)
			experience_with_pets
			(
				type = radiobuttons
				displayname = "Experience With Pets"
				values = {"First-Time Owner","Experienced Owner"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			housing_type
			(
				type = picklist
				displayname = "Housing Type"
				values = {"Independent House","Apartment","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			has_other_pets
			(
    			type = checkbox
				displayname = "Has Other Pets"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			adoption_reason
			(
    			type = textarea
				displayname = "Adoption Reason"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			verification_status
			(
				type = picklist
				displayname = "Verification Status"
				values = {"Verified","Rejected","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form adoption_application
		{
			displayname = "Adoption Application"
			success message = "Adoption Application Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			adopter
			(
				type = picklist	
				displayname = "Adopter"
				values  = adopter_registration.ID
    			displayformat = [full_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			pet
			(
				type = picklist	
				displayname = "Pet"
				values  = pet_registration.ID
    			displayformat = [pet_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			adoption_reason
			(
    			type = textarea
