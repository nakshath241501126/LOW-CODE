		workflow
		{
		form
		{
			auto_set_vaccination_status as "Auto-Set Vaccination Status"
			{
				type =  form
				form = pet_registration

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Auto-Set Vaccination Status
										// Do not assume a pet is vaccinated.
										// Preserve the status entered in Pet Registration.
										if(input.vaccination_status == null || input.vaccination_status == "")
										{
											info "Please verify vaccination records and enter the correct status.";
										}
										else
										{
											info "Vaccination status recorded for pet: " + input.pet_name;
										}
						)
					}
				}

			}
			cancel_adoption_unverified as "Cancel Adoption if Unverified"
			{
				type =  form
				form = adoption_application

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											/* Validate adopter verification status */
										if(input.adopter != null)
										{
											adopterRecord = adopter_registration[ID == input.adopter];
											if(adopterRecord.count() == 0)
											{
												alert "Adopter record was not found.";
												cancel submit;
											}
											else if(adopterRecord.verification_status != "Verified")
											{
												alert "Adopter verification status must be Verified before submitting an adoption application.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			send_adoption_confirmation_email as "Send Adoption Confirmation Email"
			{
				type =  form
				form = adoption_application

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the adopter details from the adoption application
										adopterRecord = adopter_registration[ID == input.adopter];
										// Check if adopter email is valid
										if(adopterRecord.email.isNull())
										{
											info "Adopter email is missing";
										}
										else
										{
											// Prepare email subject
											subject = "Adoption Application Confirmation - " + input.pet.pet_name;
											// Prepare email body with confirmation details
											emailBody = "<p>Dear " + adopterRecord.full_name.first_name + ",</p>";
											emailBody = emailBody.concat("<p>Your adoption application for <strong>" + input.pet.pet_name + "</strong> has been successfully submitted.</p>");
											emailBody = emailBody.concat("<p><strong>Application Details:</strong></p>");
											emailBody = emailBody.concat("<ul>");
											emailBody = emailBody.concat("<li><strong>Pet:</strong> " + input.pet.pet_name + "</li>");
											emailBody = emailBody.concat("<li><strong>Application Date:</strong> " + input.application_date.toString() + "</li>");
											emailBody = emailBody.concat("<li><strong>Status:</strong> Under Review</li>");
											emailBody = emailBody.concat("</ul>");
											emailBody = emailBody.concat("<p>We will review your application and get back to you within 5 business days.</p>");
											emailBody = emailBody.concat("<p>Thank you for your interest in adopting a pet!</p>");
											emailBody = emailBody.concat("<p>Best regards,<br>Pet Adoption Care System Team</p>");
											// Send confirmation email to adopter
											sendmail
											[
												from :zoho.loginuserid
												to :"lathika.s.2024.aiml@rajalakshmi.edu.in"
												subject :subject
												message :emailBody
												content type :HTML
											]
										}
						)
					}
				}

			}
			Validate_Pet_Availability as "Validate Pet Availability"
			{
				type =  form
				form = adoption_application

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											/* Validate selected pet availability */
										if(input.pet != null)
										{
											petRecord = pet_registration[ID == input.pet];
											if(petRecord.count() == 0)
											{
												alert "Selected pet record was not found.";
												cancel submit;
											}
											else if(petRecord.adoption_status != "Available")
											{
												alert "This pet is not available for adoption. Please select another pet.";
												cancel submit;
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			vaccination_due_date_reminder as "Vaccination Due Date Reminder"
			{
				type =  schedule
				form = pet_health_care_records
					status = inactive
				start = next_due_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch pet health care records with upcoming vaccination due dates (next 7 days)
										upcomingRecords = pet_health_care_records[next_due_date in next 7 days];
										// Iterate through each record to send email reminders
										for each  record in upcomingRecords
										{
											// Check if the record has a valid next due date and is not already completed
											if(!record.next_due_date.isNull() && record.care_status != "Completed")
											{
												// Get the pet details from the lookup
												petRecord = pet_registration[ID == record.pet.ID];
												// Prepare email subject
												subject = "Upcoming Vaccination Reminder for " + petRecord.pet_name;
												// Prepare email message
												message = "Dear Pet Owner,\n\nThis is a reminder that your pet " + petRecord.pet_name + " has an upcoming vaccination scheduled on " + record.next_due_date.toString() + ".\n\nVaccination Details:\n- Vaccination Name: " + record.vaccination_name + "\n- Care Type: " + record.care_type + "\n\nPlease ensure your pet arrives on time for the appointment.\n\nThank you,\nPet Adoption Care System";
												// Send email to the logged-in user (admin or current user)
												sendmail
												[
													from :zoho.loginuserid
													to :zoho.loginuserid
													subject :subject
													message :message
													content type :Plain Text
												]
											}
										}
					)
					}
				}
			}
		}


